<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules (API 31+; referenced by android:dataExtractionRules).
   Exclude the EncryptedSharedPreferences store (and its plaintext fallback)
   from BOTH cloud backup and device-to-device transfer. The AES master key is
   in the AndroidKeyStore and does not reliably travel with either, so a
   restored/transferred encrypted file can't be decrypted on the new device and
   crashes launch with KeyStoreException/AEADBadTagException (Crashlytics:
   SecurePreferences.<init>). Excluding it = the user just re-logs in once.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="laudea_secure_prefs.xml"/>
        <exclude domain="sharedpref" path="laudea_secure_prefs_fallback.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="laudea_secure_prefs.xml"/>
        <exclude domain="sharedpref" path="laudea_secure_prefs_fallback.xml"/>
    </device-transfer>
</data-extraction-rules>
